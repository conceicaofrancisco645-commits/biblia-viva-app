rules_version = '2';

// Bíblia Viva: cada usuário só lê e grava o próprio documento (users/{uid}).
// Publicado em: Console do Firebase > Firestore > Regras.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
